{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "strict": false,
    "types": ["node"]
  },
  "include": [
    "shared/**/*.ts",
    "shared/**/*.tsx",
    "tools/**/*.ts",
    "codex/src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "worktrees",
    ".wavemill",
    "fixtures",
    "**/*.test.ts",
    "**/*.fixtures.ts",
    "**/fixtures/**",
    "**/test-fixtures/**",
    "shared/lib/native-agent/certification/scenarios/**"
  ]
}
