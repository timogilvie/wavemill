{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "native-certification-artifact",
  "title": "NativeCertificationArtifact",
  "description": "Native agent certification artifact stored under .wavemill/native-agent-certifications/<provider>/<model>/<suite-version>.json",
  "oneOf": [
    {
      "$ref": "#/$defs/CurrentArtifact"
    },
    {
      "$ref": "#/$defs/HistoricalV2Artifact"
    }
  ],
  "$defs": {
    "CurrentArtifact": {
      "type": "object",
      "required": [
        "schemaVersion",
        "subject",
        "provider",
        "model",
        "phase",
        "suiteVersion",
        "certifiedAt",
        "scenarios"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 3
        },
        "subject": {
          "$ref": "#/$defs/CertificationSubject"
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "type": "string",
          "enum": ["read-only", "patch", "workflow"]
        },
        "suiteVersion": {
          "type": "string",
          "minLength": 1
        },
        "certifiedAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "scenarios": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ScenarioResult"
          }
        },
        "knownLimitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "totalRetryCount": {
          "type": "integer",
          "minimum": 0
        },
        "liveSmokeEvidence": {
          "$ref": "#/$defs/LiveSmokeEvidence"
        },
        "liveCanary": {
          "$ref": "#/$defs/LiveCodingCanaryResult"
        },
        "resolvedTarget": {
          "$ref": "#/$defs/ResolvedCertificationTarget"
        },
        "identityInvalidation": {
          "$ref": "#/$defs/IdentityInvalidation"
        }
      }
    },
    "HistoricalV2Artifact": {
      "type": "object",
      "required": [
        "schemaVersion",
        "provider",
        "model",
        "phase",
        "suiteVersion",
        "certifiedAt",
        "scenarios"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 2
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "type": "string",
          "enum": ["read-only", "patch", "workflow"]
        },
        "suiteVersion": {
          "type": "string",
          "minLength": 1
        },
        "certifiedAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "scenarios": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ScenarioResult"
          }
        },
        "knownLimitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "totalRetryCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "CertificationSubject": {
      "type": "object",
      "required": [
        "registryKey",
        "nativeProvider",
        "providerId",
        "providerModelId",
        "providerNativeId",
        "identityRevision",
        "identityFingerprint",
        "catalogHash"
      ],
      "additionalProperties": false,
      "properties": {
        "registryKey": {
          "type": "string",
          "minLength": 1
        },
        "nativeProvider": {
          "type": "string",
          "minLength": 1
        },
        "providerId": {
          "type": "string",
          "minLength": 1
        },
        "providerModelId": {
          "type": "string",
          "minLength": 1
        },
        "providerNativeId": {
          "type": "string",
          "minLength": 1
        },
        "identityRevision": {
          "type": "integer",
          "minimum": 1
        },
        "identityFingerprint": {
          "type": "string",
          "minLength": 1
        },
        "catalogHash": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "LiveSmokeEvidence": {
      "type": "object",
      "required": ["requestedWireId", "catalogHash", "succeededAt"],
      "additionalProperties": false,
      "properties": {
        "requestedWireId": {
          "type": "string",
          "minLength": 1
        },
        "providerReturnedModel": {
          "type": "string",
          "minLength": 1
        },
        "catalogHash": {
          "type": "string",
          "minLength": 1
        },
        "succeededAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "LiveCodingCanaryResult": {
      "type": "object",
      "required": [
        "scenarioId",
        "status",
        "isLive",
        "phase",
        "provider",
        "model",
        "providerNativeId",
        "identityFingerprint",
        "catalogHash",
        "suiteVersion",
        "ranAt",
        "limits"
      ],
      "additionalProperties": false,
      "properties": {
        "scenarioId": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": ["pass", "fail", "inconclusive", "skipped"]
        },
        "isLive": {
          "type": "boolean"
        },
        "phase": {
          "type": "string",
          "const": "coding"
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "providerNativeId": {
          "type": "string",
          "minLength": 1
        },
        "identityFingerprint": {
          "type": "string",
          "minLength": 1
        },
        "catalogHash": {
          "type": "string",
          "minLength": 1
        },
        "suiteVersion": {
          "type": "string",
          "minLength": 1
        },
        "ranAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "limits": {
          "$ref": "#/$defs/LiveCodingCanaryLimits"
        },
        "usage": {
          "$ref": "#/$defs/LiveCodingCanaryUsage"
        },
        "reason": {
          "type": "string",
          "enum": [
            "protocol_failure",
            "missing_completion_artifact",
            "wrong_mutation",
            "extra_repository_change",
            "provider_transient_error",
            "provider_config_error",
            "budget_exceeded",
            "not_live",
            "identity_mismatch",
            "internal_error"
          ]
        },
        "limitExceeded": {
          "type": "string",
          "enum": ["wall_clock", "turns", "tool_calls", "tokens", "cost"]
        },
        "detail": {
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/LiveCodingCanaryEvidence"
        },
        "attempts": {
          "type": "integer",
          "minimum": 1
        },
        "lastInconclusiveAttempt": {
          "type": "object",
          "required": ["ranAt", "status", "reason"],
          "additionalProperties": false,
          "properties": {
            "ranAt": {
              "type": "string",
              "format": "date-time"
            },
            "status": {
              "type": "string",
              "const": "inconclusive"
            },
            "reason": {
              "type": "string",
              "enum": [
                "protocol_failure",
                "missing_completion_artifact",
                "wrong_mutation",
                "extra_repository_change",
                "provider_transient_error",
                "provider_config_error",
                "budget_exceeded",
                "not_live",
                "identity_mismatch",
                "internal_error"
              ]
            },
            "detail": {
              "type": "string"
            }
          }
        }
      }
    },
    "LiveCodingCanaryLimits": {
      "type": "object",
      "required": ["maxWallClockMs", "maxTurns", "maxToolCalls", "maxTotalTokens"],
      "additionalProperties": false,
      "properties": {
        "maxWallClockMs": {
          "type": "integer",
          "minimum": 1
        },
        "maxTurns": {
          "type": "integer",
          "minimum": 1
        },
        "maxToolCalls": {
          "type": "integer",
          "minimum": 1
        },
        "maxTotalTokens": {
          "type": "integer",
          "minimum": 1
        },
        "maxCostUsd": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "LiveCodingCanaryUsage": {
      "type": "object",
      "required": ["turns", "toolCalls", "inputTokens", "outputTokens", "wallClockMs"],
      "additionalProperties": false,
      "properties": {
        "turns": {
          "type": "integer",
          "minimum": 0
        },
        "toolCalls": {
          "type": "integer",
          "minimum": 0
        },
        "inputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "wallClockMs": {
          "type": "integer",
          "minimum": 0
        },
        "costUsd": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "LiveCodingCanaryEvidence": {
      "type": "object",
      "required": [
        "structuredMutationToolCalls",
        "mutationToolNames",
        "expectedSentinelHash",
        "changedPaths",
        "completionArtifactPresent"
      ],
      "additionalProperties": false,
      "properties": {
        "structuredMutationToolCalls": {
          "type": "integer",
          "minimum": 0
        },
        "mutationToolNames": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "expectedSentinelHash": {
          "type": "string",
          "minLength": 1
        },
        "actualSentinelHash": {
          "type": "string",
          "minLength": 1
        },
        "changedPaths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "completionArtifactPresent": {
          "type": "boolean"
        },
        "completionArtifactHash": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ResolvedCertificationTarget": {
      "type": "object",
      "required": ["requestedWireId", "model", "observedAt", "source"],
      "additionalProperties": false,
      "properties": {
        "requestedWireId": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "string",
          "const": "provider-response"
        },
        "responseId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "IdentityInvalidation": {
      "type": "object",
      "required": [
        "invalidatedAt",
        "reason",
        "expectedModel",
        "observedModel",
        "requestedWireId",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "invalidatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "reason": {
          "type": "string",
          "const": "identity_mismatch"
        },
        "expectedModel": {
          "type": "string",
          "minLength": 1
        },
        "observedModel": {
          "type": "string",
          "minLength": 1
        },
        "requestedWireId": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "enum": ["runtime", "certification"]
        },
        "phase": {
          "type": "string"
        },
        "session": {
          "type": "string"
        },
        "issue": {
          "type": "string"
        }
      }
    },
    "ScenarioResult": {
      "type": "object",
      "required": ["scenarioId", "passed"],
      "additionalProperties": false,
      "properties": {
        "scenarioId": {
          "type": "string",
          "minLength": 1
        },
        "passed": {
          "type": "boolean"
        },
        "failureMessage": {
          "type": "string"
        },
        "retryCount": {
          "type": "integer",
          "minimum": 0
        },
        "attempts": {
          "type": "integer",
          "minimum": 1
        },
        "finalAttemptStatus": {
          "type": "string",
          "enum": ["pass", "fail", "unsupported", "provider-flake"]
        },
        "failureClass": {
          "type": "string",
          "enum": ["deterministic_failure", "provider_flake", "unsupported_capability"]
        }
      }
    }
  }
}
