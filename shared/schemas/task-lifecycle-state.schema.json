{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wavemill.dev/schemas/task-lifecycle-state.schema.json",
  "title": "Wavemill Task Lifecycle State",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "workflowOutcome", "resourceDisposition"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "workflowOutcome": {
      "enum": ["active", "merged", "closed", "aborted", "error"]
    },
    "resourceDisposition": {
      "enum": ["allocated", "released", "retained", "reaping", "reaped", "verification-required"]
    },
    "retention": {
      "type": "object",
      "additionalProperties": true,
      "required": ["reason"],
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "policy": {
          "type": "string"
        },
        "actor": {
          "type": "string"
        },
        "timestamp": {
          "type": "string"
        },
        "evidence": {}
      }
    },
    "launchContract": {
      "type": "object",
      "additionalProperties": true,
      "required": ["remoteBranchDeletionPolicy"],
      "properties": {
        "baseBranch": {
          "type": "string"
        },
        "baseSha": {
          "type": "string"
        },
        "integrationMode": {
          "type": "string"
        },
        "mergeMethod": {
          "type": "string"
        },
        "requireConfirm": {
          "type": "boolean"
        },
        "remoteBranchDeletionPolicy": {
          "type": "object",
          "additionalProperties": true,
          "required": ["allowed"],
          "properties": {
            "allowed": {
              "type": "boolean"
            },
            "mode": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            },
            "source": {
              "type": "string"
            }
          }
        },
        "challengeRole": {
          "type": "string"
        },
        "challengePairId": {
          "type": "string"
        },
        "session": {
          "type": "string"
        },
        "runEpoch": {
          "type": "string"
        },
        "windowId": {
          "type": "string"
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "baseBranch": {
              "enum": ["launch-contract", "runtime-env", "cli", "user-config", "repo-config", "default"]
            },
            "requireConfirm": {
              "enum": ["launch-contract", "runtime-env", "cli", "user-config", "repo-config", "default"]
            },
            "mergeMethod": {
              "enum": ["launch-contract", "runtime-env", "cli", "user-config", "repo-config", "default"]
            },
            "remoteBranchDeletionPolicy": {
              "enum": ["launch-contract", "runtime-env", "cli", "user-config", "repo-config", "default"]
            }
          }
        }
      }
    },
    "deliveryEvidence": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "reviewedHeadSha": {
          "type": "string"
        },
        "publishedHeadSha": {
          "type": "string"
        },
        "prHeadSha": {
          "type": "string"
        },
        "prNumber": {
          "type": "string"
        },
        "prState": {
          "type": "string"
        },
        "prBaseBranch": {
          "type": "string"
        },
        "mergeSha": {
          "type": "string"
        }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "attemptId": {
          "type": "string"
        },
        "originalBranch": {
          "type": "string"
        },
        "effectiveBranch": {
          "type": "string"
        },
        "baseBranch": {
          "type": "string"
        }
      }
    },
    "prReconciliation": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "classification": {
          "enum": ["current-open", "current-merged", "historical-closed", "historical-merged", "none", "unverifiable"]
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "cleanupEpisode": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schemaVersion", "episodeId", "fingerprint", "disposition", "failureClass", "attemptCount", "updatedAt"],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "episodeId": {
          "type": "string",
          "minLength": 1
        },
        "fingerprint": {
          "type": "string",
          "minLength": 1
        },
        "fingerprintInputs": {
          "type": "object",
          "additionalProperties": true
        },
        "disposition": {
          "enum": ["pending", "reaping", "reaped", "retained", "transient", "needs-user"]
        },
        "failureClass": {
          "enum": ["expected-preservation", "transient", "operational", "none"]
        },
        "firstAttemptAt": {
          "type": "string"
        },
        "lastAttemptAt": {
          "type": "string"
        },
        "attemptCount": {
          "type": "integer",
          "minimum": 0
        },
        "maxAttempts": {
          "type": "integer",
          "minimum": 1
        },
        "nextRetryAt": {
          "type": ["string", "null"]
        },
        "requiredOperatorAction": {
          "type": "string"
        },
        "lastOutcome": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      }
    },
    "normalizedFromLegacy": {
      "type": "boolean"
    },
    "verificationRequiredReason": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "workflowOutcome": {
            "enum": ["merged", "closed", "aborted", "error"]
          },
          "resourceDisposition": {
            "enum": ["allocated", "retained", "verification-required"]
          }
        },
        "required": ["workflowOutcome", "resourceDisposition"]
      },
      "then": {
        "required": ["retention"]
      }
    },
    {
      "not": {
        "properties": {
          "workflowOutcome": {
            "const": "active"
          },
          "resourceDisposition": {
            "const": "reaped"
          }
        },
        "required": ["workflowOutcome", "resourceDisposition"]
      }
    }
  ]
}
