{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage-result.schema.json",
  "title": "StageResult",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "stage",
    "status"
  ],
  "properties": {
    "stage": {
      "enum": [
        "planning",
        "coding",
        "review",
        "ready"
      ]
    },
    "status": {
      "enum": [
        "running",
        "awaiting_user",
        "completed",
        "aborted",
        "failed"
      ]
    },
    "startedAt": {
      "type": "string"
    },
    "finishedAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "agent": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "intendedModel": {
      "description": "Model requested by routing/launch. Diagnostic intent only; not execution proof.",
      "type": [
        "string",
        "null"
      ]
    },
    "executedModel": {
      "description": "Model proven by runtime evidence to have executed, or null when evidence is missing/contradictory.",
      "type": [
        "string",
        "null"
      ]
    },
    "executionEvidence": {
      "description": "Durable provenance for executedModel resolution.",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "status": {
          "enum": [
            "direct",
            "missing",
            "contradicted",
            "inherited"
          ]
        },
        "source": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "recordedAt": {
          "type": "string"
        },
        "providerReportedModel": {
          "type": "string"
        },
        "requestedWireId": {
          "type": "string"
        },
        "certifiedTarget": {
          "type": "string"
        },
        "identityVerdict": {
          "enum": [
            "match",
            "alias-resolved",
            "mismatch",
            "unverifiable",
            "absent"
          ]
        },
        "transportProvider": {
          "type": "string"
        },
        "upstreamProvider": {
          "type": "string"
        },
        "responseId": {
          "type": "string"
        },
        "piRuntimeVersions": {
          "description": "HOK-3164: installed Pi runtime package versions that ran this stage.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pi-agent-core": {
              "type": "string"
            },
            "pi-ai": {
              "type": "string"
            }
          }
        }
      }
    },
    "modelAttributionEligible": {
      "description": "True only when executedModel is evidence-backed and usable for model-quality attribution.",
      "type": "boolean"
    },
    "modelAttributionIneligibleReason": {
      "enum": [
        "stage_not_completed",
        "missing_execution_evidence",
        "execution_contradicted",
        "runtime_fallback",
        "provider_substitution"
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "failureReason": {
      "type": [
        "string",
        "null"
      ]
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "failureCategory": {
          "type": "string"
        },
        "usage": {
          "$ref": "#/$defs/stageExecutionUsage"
        }
      }
    },
    "budgetExhausted": {
      "$ref": "#/$defs/budgetExhausted"
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "source": {
      "description": "Set when the artifact was carried across a challenge fork rather than produced by a run in this arm's worktree (HOK-2811).",
      "enum": [
        "inherited"
      ]
    }
  },
  "$defs": {
    "codingArtifacts": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "type",
        "filesChanged",
        "linesAdded",
        "linesRemoved",
        "commitCount"
      ],
      "properties": {
        "type": {
          "const": "coding"
        },
        "filesChanged": {
          "type": "integer",
          "minimum": 0
        },
        "linesAdded": {
          "type": "integer",
          "minimum": 0
        },
        "linesRemoved": {
          "type": "integer",
          "minimum": 0
        },
        "commitCount": {
          "type": "integer",
          "minimum": 0
        },
        "usage": {
          "$ref": "#/$defs/stageExecutionUsage"
        }
      }
    },
    "stageExecutionUsage": {
      "description": "Observed native loop usage for a planning, coding or review run. Cache fields (HOK-3260) are projected from the loop's per-turn provider usage.",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "turnsCompleted": {
          "type": "number",
          "minimum": 0
        },
        "toolCallsExecuted": {
          "type": "number",
          "minimum": 0
        },
        "wallClockMs": {
          "type": "number",
          "minimum": 0
        },
        "totalInputTokens": {
          "description": "Uncached input tokens (excludes cache reads and writes).",
          "type": "number",
          "minimum": 0
        },
        "totalOutputTokens": {
          "type": "number",
          "minimum": 0
        },
        "totalCostUsd": {
          "type": "number",
          "minimum": 0
        },
        "cacheReadTokens": {
          "description": "Cache-read tokens summed over every turn.",
          "type": "number",
          "minimum": 0
        },
        "cacheWriteTokens": {
          "description": "Cache-write (creation) tokens summed over every turn.",
          "type": "number",
          "minimum": 0
        },
        "cacheHitRate": {
          "description": "cacheRead / (input + cacheRead + cacheWrite) over turns 2..n; null with fewer than two turns of usage.",
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "providerRoute": {
          "description": "Transport provider the loop called (e.g. anthropic, openrouter).",
          "type": "string"
        }
      }
    },
    "budgetExhausted": {
      "type": "object",
      "description": "HOK-3362: the one budget-exhaustion fact (shared/lib/native-agent/budget-exhaustion.ts). The fault class is derived from it, never stored.",
      "required": [
        "kind",
        "stopReason",
        "limit",
        "used",
        "progress"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "wall_clock",
            "turn",
            "tool_call",
            "token",
            "cost"
          ]
        },
        "stopReason": {
          "enum": [
            "wall_clock_limit",
            "turn_limit",
            "tool_call_limit",
            "token_limit",
            "cost_limit"
          ]
        },
        "limit": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "used": {
          "type": "number",
          "minimum": 0
        },
        "progress": {
          "type": "object",
          "required": [
            "turnsCompleted",
            "toolCallsExecuted",
            "wallClockMs"
          ],
          "additionalProperties": false,
          "properties": {
            "turnsCompleted": {
              "type": "integer",
              "minimum": 0
            },
            "toolCallsExecuted": {
              "type": "integer",
              "minimum": 0
            },
            "wallClockMs": {
              "type": "number",
              "minimum": 0
            },
            "mutationFailures": {
              "type": "integer",
              "minimum": 0
            },
            "providerWaitMs": {
              "type": "number",
              "minimum": 0
            },
            "providerErrorRetries": {
              "type": "integer",
              "minimum": 0
            },
            "interruptedRequest": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
