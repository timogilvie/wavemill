{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage-result.schema.json",
  "title": "StageResult",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "stage",
    "status"
  ],
  "properties": {
    "stage": {
      "enum": [
        "planning",
        "coding",
        "review",
        "ready"
      ]
    },
    "status": {
      "enum": [
        "running",
        "awaiting_user",
        "completed",
        "aborted",
        "failed"
      ]
    },
    "startedAt": {
      "type": "string"
    },
    "finishedAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "agent": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "intendedModel": {
      "description": "Model requested by routing/launch. Diagnostic intent only; not execution proof.",
      "type": [
        "string",
        "null"
      ]
    },
    "executedModel": {
      "description": "Model proven by runtime evidence to have executed, or null when evidence is missing/contradictory.",
      "type": [
        "string",
        "null"
      ]
    },
    "executionEvidence": {
      "description": "Durable provenance for executedModel resolution.",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "status": {
          "enum": [
            "direct",
            "missing",
            "contradicted",
            "inherited"
          ]
        },
        "source": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "recordedAt": {
          "type": "string"
        }
      }
    },
    "modelAttributionEligible": {
      "description": "True only when executedModel is evidence-backed and usable for model-quality attribution.",
      "type": "boolean"
    },
    "modelAttributionIneligibleReason": {
      "enum": [
        "stage_not_completed",
        "missing_execution_evidence",
        "execution_contradicted",
        "runtime_fallback"
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "failureReason": {
      "type": [
        "string",
        "null"
      ]
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "failureCategory": {
          "type": "string"
        }
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "source": {
      "description": "Set when the artifact was carried across a challenge fork rather than produced by a run in this arm's worktree (HOK-2811).",
      "enum": [
        "inherited"
      ]
    }
  },
  "$defs": {
    "codingArtifacts": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "type",
        "filesChanged",
        "linesAdded",
        "linesRemoved",
        "commitCount"
      ],
      "properties": {
        "type": {
          "const": "coding"
        },
        "filesChanged": {
          "type": "integer",
          "minimum": 0
        },
        "linesAdded": {
          "type": "integer",
          "minimum": 0
        },
        "linesRemoved": {
          "type": "integer",
          "minimum": 0
        },
        "commitCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
