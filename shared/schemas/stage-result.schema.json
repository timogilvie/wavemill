{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage-result.schema.json",
  "title": "StageResult",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "stage",
    "status"
  ],
  "properties": {
    "stage": {
      "enum": [
        "planning",
        "coding",
        "review",
        "ready"
      ]
    },
    "status": {
      "enum": [
        "running",
        "awaiting_user",
        "completed",
        "aborted",
        "failed"
      ]
    },
    "startedAt": {
      "type": "string"
    },
    "finishedAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "agent": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "intendedModel": {
      "description": "The model routing/configuration intended for this stage (HOK-2917).",
      "type": "string"
    },
    "executedModel": {
      "description": "The model that actually executed, resolved from runtime telemetry. Null when evidence is absent or contradictory (HOK-2917).",
      "type": ["string", "null"]
    },
    "executionEvidenceStatus": {
      "description": "How the executedModel was determined (HOK-2917).",
      "enum": ["confirmed", "fallback", "missing", "contradicted"]
    },
    "qualityEligible": {
      "description": "Whether this stage result is eligible for model-quality attribution (HOK-2917).",
      "type": "boolean"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "failureReason": {
      "type": [
        "string",
        "null"
      ]
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "failureCategory": {
          "type": "string"
        }
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "source": {
      "description": "Set when the artifact was carried across a challenge fork rather than produced by a run in this arm's worktree (HOK-2811).",
      "enum": [
        "inherited"
      ]
    }
  },
  "$defs": {
    "codingArtifacts": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "type",
        "filesChanged",
        "linesAdded",
        "linesRemoved",
        "commitCount"
      ],
      "properties": {
        "type": {
          "const": "coding"
        },
        "filesChanged": {
          "type": "integer",
          "minimum": 0
        },
        "linesAdded": {
          "type": "integer",
          "minimum": 0
        },
        "linesRemoved": {
          "type": "integer",
          "minimum": 0
        },
        "commitCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
