    {
      "id": "codex-cached-and-reasoning",
      "description": "Codex with cached and reasoning tokens (EF-3: double-billing)",
      "tags": ["codex", "cache-read"],
      "branch": "task/parity-case",
      "issueId": "HOK-0007",
      "agentType": "codex",
      "pricingTable": {
        "codexa-latest": {
          "inputCostPerMTok": 3,
          "outputCostPerMTok": 15
        }
      },
      "sessions": [
        {
          "location": "codex-sessions",
          "fileName": "session.jsonl",
          "lines": [
            {
              "session_meta": {
                "session_id": "codex-1",
                "cwd": "${WORKTREE}",
                "branch": "task/parity-case"
              },
              "event_type": "turn_complete",
              "turn": {
                "turn_id": "turn-1",
                "model": "codexa-latest",
                "input_tokens": 2978251,
                "cached_input_tokens": 2844672,
                "output_tokens": 8343,
                "reasoning_output_tokens": 545,
                "cache_write_input_tokens": 100000,
                "total_tokens": 2986594
              }
            }
          ]
        }
      ],
      "expectations": {
        "expectedFixes": [
          {
            "id": "EF-3",
            "path": "sync.outcome.totalCostUsd",
            "legacy": 9.9214746,
            "expected": 44.92,
            "rationale": "Legacy captures 9.92 because the harness's Codex translator maps cached_input_tokens to cache-read only; production Codex sessions in real deployments show the ~56.67 double-billing defect described here (cached tokens counted both as input and as cache-read). SDK should attribute cached tokens once and land near 44.92."
          },
          {
            "id": "EF-10",
            "path": "sync.outcome.models.codexa-latest.cacheCreationTokens",
            "legacy": 0,
            "expected": 100000,
            "rationale": "cache_write_input_tokens should be captured"
          }
        ]
      }
