# shellcheck shell=bash
# Fake reviewer for the mid-flight base conflict journey (HOK-3273).
#
# While the task is between coding and Ready, another contributor lands a
# change to the same file on the integration branch: a real add/add conflict,
# so the fake GitHub (which derives mergeability from the real merge) reports
# the PR CONFLICTING / DIRTY when Ready first checks it. Then review as usual.
contender="$FAKE_ROOT/contender-clone"
[[ -d "$contender/.git" ]] || git clone -q "$FAKE_GH_ORIGIN" "$contender"
(
  cd "$contender"
  git fetch -q origin
  git checkout -q -B "$BASE_BRANCH" "origin/$BASE_BRANCH"
  # Idempotent: a relaunched reviewer must not trip over its own fault.
  if ! grep -q 'contending change' journey-output.txt 2>/dev/null; then
    printf 'contending change landed mid-flight\n' > journey-output.txt
    git add journey-output.txt
    git -c user.name=contender -c user.email=contender@example.invalid commit -q -m "contending change to journey-output.txt"
    git push -q origin "$BASE_BRANCH"
  fi
)
printf '%s phase=review issue=%s fault=base-conflict\n' "$(date -u +%FT%TZ)" "$WAVEMILL_ISSUE" >> "$FAKE_AGENT_LOG"
default_review
