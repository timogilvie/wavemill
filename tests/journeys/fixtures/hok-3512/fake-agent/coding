# shellcheck shell=bash
# Inject an incomplete saved route after the correctly routed agent runs.
# HOK-3511 repairs stale executor metadata, so that no longer forces refusal.
# Preserve the original model for an explicit audited operator restoration.
if [[ ! -f "$FEATURE_DIR/refusal-injected" ]]; then
  jq '.coding' "$FEATURE_DIR/.phase-config.json" > "$FEATURE_DIR/refusal-original-coding.json"
  # Deliberate corruption, not a production route writer.
  jq 'del(.coding.model)' "$FEATURE_DIR/.phase-config.json" > "$FEATURE_DIR/.phase-config.json.tmp"
  mv "$FEATURE_DIR/.phase-config.json.tmp" "$FEATURE_DIR/.phase-config.json"
  touch "$FEATURE_DIR/refusal-injected"
  exit 143
fi
default_coding
