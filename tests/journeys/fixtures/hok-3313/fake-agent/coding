# shellcheck shell=bash
# Fake coder for the HOK-3313 replay (sourced by tests/fakes/bin/claude).
#
# HOK-3313 coder exited with SIGTERM (exit code 143) mid-run. It had already
# committed changes but not written .coding-complete. The monitor should:
# 1. Detect the agent is gone (no live process per HOK-3101)
# 2. Record the exit in a single exit-observation
# 3. Use identity from the launch record (not pane text)
# 4. Pass through failure_policy_decide (not terminal bypass)
# 5. Relaunch from the last durable commit
#
# Simulate this by starting work, committing, then exiting before completion.
# The recovery launch completes through the shared fake's normal coding contract.
if [[ -f "$FEATURE_DIR/owner-crash-injected" ]]; then
  default_coding
  return
fi
touch "$FEATURE_DIR/owner-crash-injected"
printf 'implemented %s\n' "$WAVEMILL_ISSUE" >> journey-output.txt
git add journey-output.txt
git -c user.name=fake-agent -c user.email=fake-agent@example.invalid commit -q -m "$WAVEMILL_ISSUE: work in progress"
# Replay the native launcher's millisecond startedAt, without impersonating a provider.
result="$FEATURE_DIR/.coding-result.json"
jq '.startedAt |= sub("Z$"; ".270Z")' "$result" > "$result.tmp"
mv "$result.tmp" "$result"
printf 'Made partial commit but exiting before .coding-complete\n'
exit 143
