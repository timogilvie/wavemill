# shellcheck shell=bash
default_planning
if [[ "${JOURNEY_RECOVERY_CONTRACT_REPLAY:-0}" == 1 ]]; then
  # Script the router output at the external boundary, using the selected route.
  # The real sealed-intent resolver still validates/materialises the challenger.
  jq '{planner:.planning.model,coder:.coding.model,reviewer:.review.model,
       planDepth:(.planning.depth // "light"),codeDepth:(.coding.depth // "light"),reviewMode:"static"}' \
    "$FEATURE_DIR/.phase-config.json" > "$FEATURE_DIR/.post-expansion-route.json"
fi
