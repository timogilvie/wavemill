# shellcheck shell=bash
source "$FAKE_AGENT_TOOLS_DIR/../shared/lib/task-identity.sh"
if [[ "${JOURNEY_NATIVE_ARM_EVIDENCE:-0}" == 1 ]] \
   && task_identity_is_challenger "$WAVEMILL_ISSUE"; then
  source "$FAKE_AGENT_SCRIPT_DIR/native-launcher.sh"
  fake_native_launcher_emit coding "$@"
fi
if [[ "${JOURNEY_RECOVERY_CONTRACT_REPLAY:-0}" == 1 && ! -f "$FEATURE_DIR/.journey-coding-interrupted" ]] \
   && task_identity_is_challenger "$WAVEMILL_ISSUE"; then
  touch "$FEATURE_DIR/.journey-coding-interrupted"
  printf 'preserved interrupted challenger work\n' > recovery-preserved.txt
  rm -f "$FEATURE_DIR/challenge-intent.json" "$FEATURE_DIR/.challenge-intent.json"
  echo "HOK-3326 injected coding exit" >> "$FAKE_AGENT_LOG"
  run_tool stage-result-cli.ts update "$FEATURE_DIR" coding --status failed --notes "Scripted interrupted coding attempt; implementation retained" --model-attribution-eligible false
  exit 143
fi
if [[ "${JOURNEY_CODER_ROUTE_CHANGE:-0}" == 1 && ! -f "$FEATURE_DIR/.journey-coding-failed-once" ]] \
   && ! task_identity_is_challenger "$WAVEMILL_ISSUE"; then
  # HOK-3511: one scripted coding failure on the primary after its coder was
  # moved by the expanded route. The relaunch must replay the persisted
  # contract (derived executor) under the stage's bounded retry with zero
  # operator touches — the HOK-3500 stall happened exactly here.
  touch "$FEATURE_DIR/.journey-coding-failed-once"
  echo "HOK-3511 injected coding exit" >> "$FAKE_AGENT_LOG"
  run_tool stage-result-cli.ts update "$FEATURE_DIR" coding --status failed --notes "Scripted coding failure; HOK-3511 relaunch replay" --model-attribution-eligible false
  exit 143
fi
[[ ! -f recovery-preserved.txt ]] || git add recovery-preserved.txt
default_coding

# HOK-3493: a PR that regenerates a large generated file. The path is the
# builder's data/fixture/generated tier, so the change input summarises it
# instead of carrying its text into the judge prompt. ~180 KB is well over the
# 50 KB summary threshold while staying inside the comparison's own diff-read
# buffer, which is not part of this invariant.
if [[ "${JOURNEY_LARGE_GENERATED_FILE:-0}" == 1 ]]; then
  mkdir -p generated
  awk 'BEGIN{
    print "JOURNEY_GENERATED_SENTINEL"
    for (i = 1; i <= 2000; i++)
      printf "validator payload line %05d xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\n", i
  }' > generated/huge.validator.cjs
  git add generated/huge.validator.cjs
  git -c user.name=fake-agent -c user.email=fake-agent@example.invalid commit -q -m "$WAVEMILL_ISSUE: regenerate generated/huge.validator.cjs"
fi
