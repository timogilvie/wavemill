# Fixture provenance: hand-authored HOK-3459 golden-journey adapter for this
# bounded-retry consolidation; it is not a production-incident replay.
# HOK-3459: emit an unrecognized agent error on the first coding launch. The
# monitor must persist the ordinary failed result and use stage-failure-coding.
if [[ ! -f "$FEATURE_DIR/hok-3459-error-injected" ]]; then
  touch "$FEATURE_DIR/hok-3459-error-injected"
  hook_file="/tmp/wavemill-${WAVEMILL_SESSION}-${WAVEMILL_ISSUE}.hook"
  printf '{"state":"error","event":"process_exit","detail":"decoder shard 7 returned an unknown transient failure","agent":"native","timestamp":%s}\n' \
    "$(date +%s)" > "$hook_file" 2>/dev/null || true
  exit 1
fi
default_coding
