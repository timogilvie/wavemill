# shellcheck shell=bash
# Fake reviewer for the tend rebase conflict journey (HOK-3316).
#
# While the task is in review, another PR lands on the integration branch and
# regenerates generated.txt. GitHub (the fake derives mergeability from a real
# 3-way merge) still reports the task's PR MERGEABLE, so Ready passes; only
# tend's per-commit rebase conflicts. Then review as usual.
contender="$FAKE_ROOT/contender-clone"
[[ -d "$contender/.git" ]] || git clone -q "$FAKE_GH_ORIGIN" "$contender"
(
  cd "$contender"
  git fetch -q origin
  git checkout -q -B "$BASE_BRANCH" "origin/$BASE_BRANCH"
  # Idempotent: a relaunched reviewer must not trip over its own fault.
  if ! grep -q 'from the other PR' generated.txt 2>/dev/null; then
    printf 'generated: from the other PR\n' > generated.txt
    git add generated.txt
    git -c user.name=contender -c user.email=contender@example.invalid commit -q -m "other PR regenerates generated.txt"
    git push -q origin "$BASE_BRANCH"
  fi
)
printf '%s phase=review issue=%s fault=generated-file-race\n' "$(date -u +%FT%TZ)" "$WAVEMILL_ISSUE" >> "$FAKE_AGENT_LOG"
default_review
