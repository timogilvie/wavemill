# Main command dispatcher
case "${1:-}" in
  mill)
    run_preflight_checks
    shift
    if [[ "${1:-}" == "challenge" ]]; then
      shift
      case "${1:-}" in
        repair)
          shift
          pair_id="${1:-}"
          if [[ -z "$pair_id" ]]; then
            echo -e "${RED}Error:${NC} wavemill mill challenge repair requires a pair id" >&2
            exit 1
          fi
          exec npx tsx "$TOOLS_DIR/repair-challenge-pairing.ts" --pair-id "$pair_id" --repo-dir "$PWD"
          ;;
        void)
          shift
          pair_id="${1:-}"
          if [[ -z "$pair_id" ]]; then
            echo -e "${RED}Error:${NC} wavemill mill challenge void requires a pair id" >&2
            exit 1
          fi
          shift || true
          exec npx tsx "$TOOLS_DIR/void-challenge-record.ts" --pair-id "$pair_id" --repo-dir "$PWD" "$@"
          ;;
        *)
          echo -e "${RED}Error:${NC} unknown mill challenge subcommand: ${1:-}" >&2
          exit 1
          ;;
      esac
    fi
    # Parse mill-specific flags before delegating
    mill_force_model=""
    mill_planner_model=""
    mill_coder_model=""
    mill_reviewer_model=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --help|-h)
          show_help
          exit 0
          ;;
        --agent)
          export AGENT_CMD="$2"
          export AGENT_CMD_EXPLICIT=true
          shift 2
          ;;
        --model)
          if [[ $# -lt 2 || -z "${2}" ]]; then
            echo -e "${RED}Error:${NC} --model requires a value" >&2
            exit 1
          fi
          mill_force_model="$2"
          shift 2
          ;;
        --model=*)
          if [[ -z "${1#*=}" ]]; then
            echo -e "${RED}Error:${NC} --model requires a value" >&2
            exit 1
          fi
          mill_force_model="${1#*=}"
          shift
          ;;
        --planner-model)
          if [[ $# -lt 2 || -z "${2}" ]]; then
            echo -e "${RED}Error:${NC} --planner-model requires a value" >&2
            exit 1
          fi
          mill_planner_model="$2"
          shift 2
          ;;
        --planner-model=*)
          if [[ -z "${1#*=}" ]]; then
            echo -e "${RED}Error:${NC} --planner-model requires a value" >&2
            exit 1
          fi
          mill_planner_model="${1#*=}"
          shift
          ;;
        --coder-model)
          if [[ $# -lt 2 || -z "${2}" ]]; then
            echo -e "${RED}Error:${NC} --coder-model requires a value" >&2
            exit 1
          fi
          mill_coder_model="$2"
          shift 2
          ;;
        --coder-model=*)
          if [[ -z "${1#*=}" ]]; then
            echo -e "${RED}Error:${NC} --coder-model requires a value" >&2
            exit 1
          fi
          mill_coder_model="${1#*=}"
          shift
          ;;
        --reviewer-model)
          if [[ $# -lt 2 || -z "${2}" ]]; then
            echo -e "${RED}Error:${NC} --reviewer-model requires a value" >&2
            exit 1
          fi
          mill_reviewer_model="$2"
          shift 2
          ;;
        --reviewer-model=*)
          if [[ -z "${1#*=}" ]]; then
            echo -e "${RED}Error:${NC} --reviewer-model requires a value" >&2
            exit 1
          fi
          mill_reviewer_model="${1#*=}"
          shift
          ;;
        --no-progress)
          export WAVEMILL_NO_PROGRESS=1
          shift
          ;;
        --dry-run)
          export WAVEMILL_DRY_RUN=1
          export DRY_RUN=true
          shift
          ;;
        --dry-run-backlog)
          export WAVEMILL_DRY_RUN_BACKLOG_FILE="$2"
          shift 2
          ;;
        --dry-run-backlog=*)
          export WAVEMILL_DRY_RUN_BACKLOG_FILE="${1#*=}"
          shift
          ;;
        --dry-run-plan-out)
          export WAVEMILL_DRY_RUN_PLAN_OUT="$2"
          shift 2
          ;;
        --dry-run-plan-out=*)
          export WAVEMILL_DRY_RUN_PLAN_OUT="${1#*=}"
          shift
          ;;
        *)
          break
          ;;
      esac
    done
    if [[ -n "$mill_force_model" ]] && [[ -n "$mill_planner_model$mill_coder_model$mill_reviewer_model" ]]; then
      echo -e "${RED}Error:${NC} --model cannot be combined with --planner-model, --coder-model, or --reviewer-model" >&2
      exit 1
    fi
    validate_mill_model_override "FORCE_MODEL" "$mill_force_model" "--model"
    validate_mill_model_override "WAVEMILL_PLANNER_MODEL" "$mill_planner_model" "--planner-model"
    validate_mill_model_override "WAVEMILL_CODER_MODEL" "$mill_coder_model" "--coder-model"
    validate_mill_model_override "WAVEMILL_REVIEWER_MODEL" "$mill_reviewer_model" "--reviewer-model"
    [[ -n "$mill_force_model" ]] && export FORCE_MODEL="$mill_force_model"
    [[ -n "$mill_planner_model" ]] && export WAVEMILL_PLANNER_MODEL="$mill_planner_model"
    [[ -n "$mill_coder_model" ]] && export WAVEMILL_CODER_MODEL="$mill_coder_model"
    [[ -n "$mill_reviewer_model" ]] && export WAVEMILL_REVIEWER_MODEL="$mill_reviewer_model"
    run_mill "$@"
    ;;
  expand)
    run_preflight_checks
    shift
    run_expand "$@"
    ;;
  plan)
    run_preflight_checks
    shift
    run_plan "$@"
    ;;
  native-agent)
    shift
    run_native_agent "$@"
    ;;
  scaffold)
    shift
    run_scaffold "$@"
    ;;
  review)
    run_preflight_checks
    shift
    run_review "$@"
    ;;
  ready)
    shift
    run_ready "$@"
    ;;
  abort)
    shift
    run_abort "$@"
    ;;
  cleanup)
    shift
    run_cleanup "$@"
    ;;
  tend)
    shift
    run_tend "$@"
    ;;
  observer)
    shift
    run_observer "$@"
    ;;
  promote)
    shift
    run_promote "$@"
    ;;
  context)
    run_preflight_checks
    shift
    run_context "$@"
    ;;
  hokusai)
    shift
    run_hokusai "$@"
    ;;
  quota)
    shift
    run_quota "$@"
    ;;
  eval)
    shift
    run_eval "$@"
    ;;
  intervention)
    shift
    run_intervention "$@"
    ;;
  route)
    shift
    run_route "$@"
    ;;
  reroute)
    shift
    run_reroute "$@"
    ;;
  check-routing)
    shift
    run_check_routing "$@"
    ;;
  check-ci-verification)
    shift
    run_check_ci_verification "$@"
    ;;
  parity-report)
    shift
    run_parity_report "$@"
    ;;
  doctor)
    shift
    run_doctor "$@"
    ;;
  config)
    shift
    run_config "$@"
    ;;
  init)
    shift
    run_init "$@"
    ;;
  version|--version|-v)
    show_version
    ;;
  help|--help|-h|"")
    show_help
    ;;
  *)
    echo -e "${RED}Error:${NC} Unknown command: $1" >&2
    echo ""
    show_help
    exit 1
    ;;
esac
