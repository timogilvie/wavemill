# Check if config version is up to date, offer to sync if outdated
check_config_version() {
  # Skip if explicitly disabled
  [[ "${SKIP_CONFIG_CHECK:-false}" == "true" ]] && return 0

  # Run check-config-version.ts
  local check_tool="$TOOLS_DIR/check-config-version.ts"
  if [[ ! -f "$check_tool" ]]; then
    return 0
  fi

  extract_json_field() {
    local json="$1"
    local field="$2"

    if command -v jq >/dev/null 2>&1; then
      printf '%s' "$json" | jq -r --arg field "$field" '.[$field] // empty' 2>/dev/null
      return
    fi

    printf '%s' "$json" | node -e '
      let input = "";
      process.stdin.setEncoding("utf8");
      process.stdin.on("data", (chunk) => {
        input += chunk;
      });
      process.stdin.on("end", () => {
        try {
          const parsed = JSON.parse(input);
          const value = parsed?.[process.argv[1]];
          process.stdout.write(value == null ? "" : String(value));
        } catch {
          process.exit(0);
        }
      });
    ' "$field" 2>/dev/null
  }

  # Check version (exit code 1 = needs upgrade)
  # Note: must use `|| true` to prevent set -e from exiting on non-zero
  # Redirect stderr to /dev/null so npx warnings don't corrupt the JSON output
  local check_output check_status
  check_output=$(npx tsx "$check_tool" --json 2>/dev/null) && check_status=0 || check_status=$?

  # 0 = current, 1 = needs upgrade, 2 = error
  if [[ $check_status -eq 0 ]]; then
    return 0
  fi

  local check_message current_version prompt_version
  check_message=$(extract_json_field "$check_output" "message")
  current_version=$(extract_json_field "$check_output" "currentVersion")
  current_version="${current_version:-${CONFIG_VERSION:-}}"
  if [[ -z "$check_message" && -n "$current_version" ]]; then
    check_message="Config version check did not return details (current: $current_version)."
  fi
  prompt_version="${current_version:-$(extract_json_field "$check_output" "configVersion")}"

  if [[ $check_status -eq 2 || $check_status -ne 1 ]]; then
    echo -e "${YELLOW}Warning:${NC} Config version check failed: ${check_message:-$check_output}"
    return 0
  fi

  # Needs upgrade
  echo -e "${YELLOW}Notice:${NC} ${check_message:-$check_output}"
  echo -e "  The latest config includes features like eval, review, router, and permissions."
  echo ""
  echo -e "Upgrade config to version ${prompt_version:-${CONFIG_VERSION:-$VERSION}}? This will preserve your existing settings."
  read -p "[Y/n] " -n 1 -r
  echo

  if [[ ! $REPLY =~ ^[Nn]$ ]]; then
    # Run sync-config.ts
    local sync_tool="$TOOLS_DIR/sync-config.ts"
    if [[ -f "$sync_tool" ]]; then
      echo ""
      npx tsx "$sync_tool" --yes
      echo ""
    else
      echo -e "${YELLOW}Warning:${NC} Could not find sync-config.ts"
      return 1
    fi
  else
    echo -e "${CYAN}Skipped.${NC} Upgrade later with: ${CYAN}npx tsx tools/sync-config.ts${NC}"
    echo -e "  Or run with: ${CYAN}SKIP_CONFIG_CHECK=true wavemill mill${NC} to skip this prompt"
    echo ""
  fi
}

# Check if project context is initialized, offer to create if missing
check_project_context() {
  # Skip if project context already exists
  [[ -f ".wavemill/project-context.md" ]] && return 0

  # Skip if explicitly disabled
  [[ "${SKIP_CONTEXT_CHECK:-false}" == "true" ]] && return 0

  echo -e "${YELLOW}Notice:${NC} No project context found (.wavemill/project-context.md)"
  echo -e "  Project context helps agents learn from previous work and follow established patterns."
  echo ""
  echo -e "Initialize now? This will analyze your codebase and create .wavemill/project-context.md"
  read -p "[Y/n] " -n 1 -r
  echo

  if [[ ! $REPLY =~ ^[Nn]$ ]]; then
    # Create .wavemill directory if it doesn't exist
    mkdir -p .wavemill

    # Run init-project-context.ts
    local init_tool="$TOOLS_DIR/init-project-context.ts"
    if [[ -f "$init_tool" ]]; then
      echo ""
      npx tsx "$init_tool"
      echo ""
    else
      echo -e "${YELLOW}Warning:${NC} Could not find init-project-context.ts"
      return 1
    fi
  else
    echo -e "${CYAN}Skipped.${NC} Initialize later with: ${CYAN}npx tsx tools/init-project-context.ts${NC}"
    echo -e "  Or run with: ${CYAN}SKIP_CONTEXT_CHECK=true wavemill mill${NC} to skip this prompt"
    echo ""
  fi
}

check_ci_verification_drift_on_init() {
  [[ -f ".wavemill-config.json" ]] || return 0
  [[ -f "$TOOLS_DIR/check-ci-verification.ts" ]] || return 0

  if node -e '
const fs = require("fs");
try {
  const config = JSON.parse(fs.readFileSync(".wavemill-config.json", "utf8"));
  process.exit(config?.prePrVerification?.enabled && config?.prePrVerification?.source === "github-enforced" ? 0 : 1);
} catch {
  process.exit(1);
}
'; then
    echo ""
    echo -e "${CYAN}Checking CI-to-local verification drift...${NC}"
    npx tsx "$TOOLS_DIR/check-ci-verification.ts" --repo "$PWD" --propose-mapping || true
  fi
}

# Run standard pre-flight checks before command execution
run_preflight_checks() {
  check_config_version
  check_project_context
}

run_mill() {
  local mill_script="$LIB_DIR/wavemill-mill.sh"
  local preflight_tool="$TOOLS_DIR/mill-config-preflight.ts"

  if [[ ! -f "$mill_script" ]]; then
    echo -e "${RED}Error:${NC} Mill script not found at: $mill_script" >&2
    exit 1
  fi

  # Guard: refuse to start mill inside a git worktree (HOK-1214)
  local _gd _gcd
  _gd=$(git rev-parse --git-dir 2>/dev/null || echo "")
  _gcd=$(git rev-parse --git-common-dir 2>/dev/null || echo "")
  if [[ -n "$_gd" && -n "$_gcd" && "$_gd" != "$_gcd" ]]; then
    echo -e "${RED}Error:${NC} wavemill mill cannot run inside a git worktree." >&2
    echo "  Run from the main repository root instead." >&2
    exit 1
  fi

  # Guard: refuse nested mill invocation (HOK-1214)
  if [[ -n "${WAVEMILL_MILL_ACTIVE:-}" ]]; then
    echo -e "${RED}Error:${NC} wavemill mill is already running for: $WAVEMILL_MILL_ACTIVE" >&2
    echo "  Nested mill invocations are not allowed." >&2
    exit 1
  fi

  if [[ ! -x "$mill_script" ]]; then
    chmod +x "$mill_script"
  fi

  if [[ "${WAVEMILL_SKIP_CONFIG_PREFLIGHT:-}" == "1" ]]; then
    echo -e "${YELLOW}Warning:${NC} skipping Mill config preflight (WAVEMILL_SKIP_CONFIG_PREFLIGHT=1)" >&2
  elif [[ -f "$preflight_tool" ]]; then
    if ! npx tsx "$preflight_tool" --repo-dir "$PWD"; then
      echo -e "${RED}Error:${NC} Mill config preflight failed." >&2
      echo "  Run: wavemill config migrate-model-settings" >&2
      exit 1
    fi
  else
    echo -e "${RED}Error:${NC} Mill config preflight tool not found at: $preflight_tool" >&2
    exit 1
  fi

  echo -e "${CYAN}Starting Wavemill Mill...${NC}"
  WAVEMILL_MILL_LIB_DIR="$LIB_DIR" exec "$BASH" "$mill_script" "$@"
}

validate_mill_model_override() {
  local env_name="$1"
  local model="$2"
  local label="$3"
  local validator="$LIB_DIR/model-validator.ts"

  [[ -n "$model" ]] || return 0
  if [[ ! -f "$validator" ]]; then
    echo -e "${RED}Error:${NC} model validation requires $validator" >&2
    exit 1
  fi

  if command -v tsx >/dev/null 2>&1; then
    if tsx "$validator" --selector-token "$model" "$PWD" >/dev/null; then
      return 0
    fi
  elif command -v npx >/dev/null 2>&1; then
    if npx tsx "$validator" --selector-token "$model" "$PWD" >/dev/null; then
      return 0
    fi
  else
    echo -e "${RED}Error:${NC} model validation requires tsx or npx" >&2
    exit 1
  fi

  echo -e "${RED}Error:${NC} Invalid $env_name: $model" >&2
  echo "  $label must be a supported model selector or model ID." >&2
  exit 1
}

run_init() {
  local target=".wavemill-config.json"
  local context_exists=false
  local linear_api_status="not found"
  local hokusai_api_status="not found"
  local detected_linear_project=""
  local linear_project=""
  local max_parallel="3"
  local use_hokusai_routing="false"
  local hokusai_router_mode="auto"
  local hokusai_data_submission="false"
  local hokusai_contributions_enabled="false"
  local hokusai_contribution_upload="false"
  local review_enabled="true"
  local integration_enabled="false"
  local merge_queue_enabled="false"
  local auto_eval="true"
  local linear_project_json=""
  local router_hokusai_block=""

  # Check if config already exists
  if [[ -f "$target" ]]; then
    echo -e "${YELLOW}Warning:${NC} $target already exists"
    read -p "Overwrite? [y/N] " -n 1 -r
    echo
    [[ $REPLY =~ ^[Yy]$ ]] || exit 0
  fi

  has_env_or_dotenv_var() {
    local var_name="$1"
    if [[ -n "${!var_name:-}" ]]; then
      return 0
    fi
    if [[ -f ".env" ]] && grep -Eq "^[[:space:]]*(export[[:space:]]+)?${var_name}=" ".env"; then
      return 0
    fi
    return 1
  }

  get_env_or_dotenv_var() {
    local var_name="$1"
    local line=""
    local value=""
    if [[ -n "${!var_name:-}" ]]; then
      printf '%s' "${!var_name}"
      return 0
    fi
    if [[ ! -f ".env" ]]; then
      return 0
    fi
    line="$(grep -E "^[[:space:]]*(export[[:space:]]+)?${var_name}=" ".env" 2>/dev/null | tail -n 1 || true)"
    [[ -n "$line" ]] || return 0
    value="${line#*=}"
    value="${value%$'\r'}"
    if [[ "$value" == \"*\" && "$value" == *\" ]]; then
      value="${value#\"}"
      value="${value%\"}"
    elif [[ "$value" == \'*\' && "$value" == *\' ]]; then
      value="${value#\'}"
      value="${value%\'}"
    fi
    printf '%s' "$value"
  }

  json_escape() {
    local value="$1"
    value="${value//\\/\\\\}"
    value="${value//\"/\\\"}"
    value="${value//$'\n'/\\n}"
    printf '%s' "$value"
  }

  prompt_line() {
    local prompt="$1"
    local default_value="$2"
    local answer=""
    if [[ -n "$default_value" ]]; then
      read -r -p "$prompt [$default_value] " answer
      printf '%s' "${answer:-$default_value}"
    else
      read -r -p "$prompt " answer
      printf '%s' "$answer"
    fi
  }

  prompt_yes_no() {
    local prompt="$1"
    local default_value="$2"
    local answer=""
    local suffix="[y/N]"
    [[ "$default_value" == "true" ]] && suffix="[Y/n]"
    while true; do
      read -r -p "$prompt $suffix " answer
      if [[ -z "$answer" ]]; then
        [[ "$default_value" == "true" ]] && return 0 || return 1
      fi
      case "$answer" in
        [Yy]|[Yy][Ee][Ss]) return 0 ;;
        [Nn]|[Nn][Oo]) return 1 ;;
        *) echo "Please answer y or n." ;;
      esac
    done
  }

  prompt_positive_int() {
    local prompt="$1"
    local default_value="$2"
    local answer=""
    while true; do
      answer="$(prompt_line "$prompt" "$default_value")"
      if [[ "$answer" =~ ^[1-9][0-9]*$ ]]; then
