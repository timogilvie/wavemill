  if [[ ! -f "$observer_tool" ]]; then
    echo -e "${RED}Error:${NC} Observer tool not found at: $observer_tool" >&2
    exit 1
  fi

  echo -e "${CYAN}Starting Wavemill Observer...${NC}"
  exec npx tsx "$observer_tool" "$@"
}

